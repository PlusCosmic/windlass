{
  "name": "@pluscosmic/windlass",
  "version": "0.1.0",
  "description": "Policy engine that decides whether agent-authored pull requests auto-merge, escalate or block.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run build:action && bun run build:app && bun run build:web && bun run format:check",
    "build:action": "node action/build.mjs",
    "check:action-dist": "bun run build:action && git diff --exit-code -- action/dist",
    "build:app": "node app/build.mjs",
    "build:web": "vite build web",
    "dev:server": "node app/build.mjs && WINDLASS_DEV=1 node app/dist/server.mjs",
    "dev:web": "vite web"
  },
  "dependencies": {
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.8",
    "@octokit/rest": "^22.0.1",
    "@pluscosmic/ui": "https://github.com/PlusCosmic/ui-foundation/releases/download/ui-v0.1.3/pluscosmic-ui-0.1.3.tgz",
    "@tabler/icons-react": "^3.52.0",
    "@types/node": "^24.19.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "hono": "^4.13.18",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.3.13"
}
